<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maths Challenge</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #667eea, #764ba2);
      padding: 20px;
    }

    .game {
      width: 100%;
      max-width: 400px;
      background: white;
      padding: 30px 25px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    h1 {
      color: #333;
      margin-bottom: 10px;
    }

    .score {
      color: #666;
      margin-bottom: 25px;
      font-size: 18px;
    }

    .question {
      font-size: 35px;
      font-weight: bold;
      color: #222;
      margin-bottom: 25px;
    }

    .answers {
      display: grid;
      gap: 12px;
    }

    .answer {
      border: none;
      padding: 15px;
      border-radius: 12px;
      background: #f1f3f5;
      font-size: 18px;
      cursor: pointer;
      transition: 0.2s;
    }

    .answer:hover {
      background: #667eea;
      color: white;
      transform: scale(1.02);
    }

    .answer.correct {
      background: #2ecc71;
      color: white;
    }

    .answer.wrong {
      background: #e74c3c;
      color: white;
    }

    #nextBtn,
    #restartBtn {
      margin-top: 20px;
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: #667eea;
      color: white;
      font-size: 17px;
      cursor: pointer;
    }

    #nextBtn:hover,
    #restartBtn:hover {
      background: #5568d9;
    }

    #result {
      display: none;
    }

    #result h2 {
      margin-bottom: 15px;
      color: #333;
    }

    #finalScore {
      font-size: 25px;
      font-weight: bold;
      color: #667eea;
    }
  </style>
</head>

<body>

  <div class="game">

    <div id="gameScreen">
      <h1>🧠 Maths Challenge</h1>

      <div class="score">
        Question <span id="questionNumber">1</span>/10
        <br>
        Score: <span id="score">0</span>
      </div>

      <div class="question" id="question">
        5 + 5 = ?
      </div>

      <div class="answers" id="answers"></div>

      <button id="nextBtn" onclick="nextQuestion()" style="display:none;">
        Next Question ➜
      </button>
    </div>

    <div id="result">
      <h1>🎉 Game Over!</h1>
      <h2>Your Final Score</h2>

      <div id="finalScore">0 / 10</div>

      <button id="restartBtn" onclick="restartGame()">
        🔄 Play Again
      </button>
    </div>

  </div>

  <script>

    let currentQuestion = 0;
    let score = 0;
    let correctAnswer = 0;

    const totalQuestions = 10;

    function generateQuestion() {

      const num1 = Math.floor(Math.random() * 20) + 1;
      const num2 = Math.floor(Math.random() * 20) + 1;

      const operations = ["+", "-", "×"];
      const operation =
        operations[Math.floor(Math.random() * operations.length)];

      if (operation === "+") {
        correctAnswer = num1 + num2;
      }

      else if (operation === "-") {
        correctAnswer = num1 - num2;
      }

      else {
        correctAnswer = num1 * num2;
      }

      document.getElementById("question").textContent =
        `${num1} ${operation} ${num2} = ?`;

      createAnswers();
    }

    function createAnswers() {

      const answersDiv = document.getElementById("answers");

      answersDiv.innerHTML = "";

      let answers = [correctAnswer];

      while (answers.length < 4) {

        let randomAnswer =
          correctAnswer + Math.floor(Math.random() * 21) - 10;

        if (!answers.includes(randomAnswer)) {
          answers.push(randomAnswer);
        }
      }

      answers.sort(() => Math.random() - 0.5);

      answers.forEach(answer => {

        const button = document.createElement("button");

        button.classList.add("answer");
        button.textContent = answer;

        button.onclick = () => checkAnswer(button, answer);

        answersDiv.appendChild(button);
      });
    }

    function checkAnswer(button, answer) {

      const buttons =
        document.querySelectorAll(".answer");

      buttons.forEach(btn => {
        btn.disabled = true;

        if (Number(btn.textContent) === correctAnswer) {
          btn.classList.add("correct");
        }
      });

      if (answer === correctAnswer) {
        score++;
        document.getElementById("score").textContent = score;
      } else {
        button.classList.add("wrong");
      }

      document.getElementById("nextBtn").style.display = "block";
    }

    function nextQuestion() {

      currentQuestion++;

      if (currentQuestion >= totalQuestions) {
        showResult();
        return;
      }

      document.getElementById("questionNumber").textContent =
        currentQuestion + 1;

      document.getElementById("nextBtn").style.display = "none";

      generateQuestion();
    }

    function showResult() {

      document.getElementById("gameScreen").style.display = "none";
      document.getElementById("result").style.display = "block";

      document.getElementById("finalScore").textContent =
        `${score} / ${totalQuestions}`;
    }

    function restartGame() {

      currentQuestion = 0;
      score = 0;

      document.getElementById("score").textContent = "0";
      document.getElementById("questionNumber").textContent = "1";

      document.getElementById("gameScreen").style.display = "block";
      document.getElementById("result").style.display = "none";

      generateQuestion();
    }

    // Start game
    generateQuestion();

  </script>

</body>
</html>